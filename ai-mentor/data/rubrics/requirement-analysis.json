{
  "id": "requirement-analysis",
  "name": "需求分析作业批改标准",
  "items": [
    {
      "id": "goal",
      "name": "目标是否说清",
      "weight": 25,
      "probe": "这个需求要解决谁的什么问题？不用专业术语，用一句话说。",
      "levels": {
        "1": "只复述了需求原文，没有提炼目标",
        "3": "说清了目标用户和要解决的问题",
        "5": "能指出目标背后的业务指标，并判断需求本身是否成立"
      },
      "signals": {
        "good": ["目标用户", "要解决的问题", "业务价值", "指标", "场景", "痛点"],
        "bad": ["需求就是", "照做", "原文是"]
      }
    },
    {
      "id": "scope",
      "name": "范围与边界",
      "weight": 25,
      "probe": "这次做什么、明确不做什么？如果有争议，你打算怎么定？",
      "levels": {
        "1": "没有边界，什么都想做",
        "3": "列出了本期做与不做",
        "5": "对争议项给出判断依据，并说明延后做的理由"
      },
      "signals": {
        "good": ["本期", "不包含", "暂不", "范围", "边界", "后续迭代", "优先级"],
        "bad": ["都做", "顺便", "一起做了"]
      }
    },
    {
      "id": "exceptions",
      "name": "异常与分支覆盖",
      "weight": 25,
      "probe": "用户在极端情况下会怎么用？有哪些你没写进主流程的分支？",
      "levels": {
        "1": "只有理想路径",
        "3": "覆盖了主要异常分支",
        "5": "覆盖异常、权限、数据为空、重复提交等边界，并给出处理方式"
      },
      "signals": {
        "good": ["异常", "失败", "为空", "重复", "权限", "超时", "边界", "错误提示", "兜底"],
        "bad": ["不会发生", "用户不会这样", "忽略"]
      }
    },
    {
      "id": "acceptance",
      "name": "可验收性",
      "weight": 25,
      "probe": "做完之后，怎么验证它是成功的？给我三条可检查的标准。",
      "levels": {
        "1": "没有验收标准",
        "3": "有标准但不可量化",
        "5": "给出可量化、可复现的验收标准与验证方法"
      },
      "signals": {
        "good": ["验收", "标准", "可量化", "通过率", "耗时", "复现", "检查项", "测试用例"],
        "bad": ["看起来没问题", "应该可以", "感觉"]
      }
    }
  ]
}
